# Cloudflare Pages Environment Variables Example
# Copy this to Cloudflare Pages Dashboard > Settings > Environment Variables

# Enable Cloudflare Pages mode
CLOUDFLARE_PAGES=true

# Website URL (your Cloudflare Pages URL)
NEXT_PUBLIC_WEBSITE_URL=https://your-project.pages.dev

# Note: Sentry is disabled in Cloudflare builds (withSentryConfig is skipped
# when CLOUDFLARE_PAGES=true), so setting a Sentry DSN here has no effect.

# Google Tag Manager ID (optional, for analytics)
# NEXT_PUBLIC_GTM_ID=your-gtm-id

# Node version (for build)
NODE_VERSION=18.17.0
